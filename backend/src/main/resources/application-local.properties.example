# 1) Copy this file to application-local.properties (same folder).
# 2) Fill in values. application-local.properties is gitignored and is not pushed.

# --- Gmail ---
spring.mail.username=you@gmail.com
spring.mail.password=your-16-char-app-password
app.mail.from=you@gmail.com

# --- Mailtrap instead (optional): override host in application.properties comments + set: ---
# spring.mail.host=sandbox.smtp.mailtrap.io
# spring.mail.port=2525
# spring.mail.username=
# spring.mail.password=
# app.mail.from=noreply@localhost

# --- Twilio (optional) ---
# app.sms.twilio-account-sid=
# app.sms.twilio-auth-token=
# app.sms.twilio-from-number=
