# 1) Copy this file to application-local.properties (same folder).
# 2) Fill in values. application-local.properties is gitignored and is not pushed.

# --- Gmail ---
spring.mail.username=you@gmail.com
spring.mail.password=your-16-char-app-password
app.mail.from=you@gmail.com

# --- Mailtrap instead (optional): override host in application.properties comments + set: ---
# spring.mail.host=sandbox.smtp.mailtrap.io
# spring.mail.port=2525
# spring.mail.username=
# spring.mail.password=
# app.mail.from=noreply@localhost

# --- Twilio SMS (optional) ---
# REST auth always uses Account SID (starts with AC) from Twilio Console → Account → API keys / Account Info.
# If you use a Messaging Service (starts with MG), put it in twilio.messaging.service.sid — not in twilio.account.sid.
# app.sms.enabled=true
# twilio.account.sid=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# twilio.auth.token=
# Optional: send via Messaging Service (use this OR from-number below)
# twilio.messaging.service.sid=MGxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# Optional: send from this number if not using a Messaging Service
# twilio.from.number=+1xxxxxxxxxx

